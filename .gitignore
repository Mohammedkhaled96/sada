.venv/
__pycache__/
*.pyc

# Model checkpoints: 461 MB to 2.9 GB each, fetched on demand.
models/
# settings.json is tracked on purpose, so a fresh clone and a fresh install
# start from the same known configuration rather than from whatever the
# program happens to write first.
#
# The cost of that is real and worth knowing: this file is now part of the
# repository, so a `git pull` overwrites whatever settings are in the working
# copy, and every change made in the Settings window shows up as a modified
# file. Before committing anything else, check `git diff settings.json` - the
# microphone name, the corrections list and the chosen shortcuts all live in
# here, and they are nobody else's business.
settings.tmp
# The daemon writes the port and token it is listening on.
endpoint.json
# This one person's run: which microphone they used, what failed and when.
# Theirs to send when something goes wrong, not ours to publish.
sada.log
sada.log.1
# Transcripts and checkpoints produced by a run.
out/
# Audio dropped in for the container to read.
audio/
# A token pasted into publish-to-dockerhub.bat must never be committed.
publish-to-dockerhub.local.bat

# ffmpeg/ffprobe are third-party binaries the user supplies (README: put them in
# bin/ or on PATH). ffmpeg.exe alone is 242 MB - over GitHub's 100 MB limit.
bin/*.exe

# Built installers are published as GitHub release assets, not committed
# (Sada-Setup-1.0.0.exe is 238 MB; GitHub rejects files over 100 MB).
release/*.exe
dist/
build/

# The Arabic SAPI voice drops a dictionary file in the working
# directory the first time tests/speechgen.py uses it.
*.dic
